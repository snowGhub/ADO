<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LocalDB liefert SqlUserInstance.dll nur als x64/x86. Auf ARM64-Windows
         muss der Prozess daher x64 sein, sonst schlaegt das Laden mit
         Win32-Fehler 193 fehl ("keine zulaessige Win32-Anwendung"). -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

</Project>